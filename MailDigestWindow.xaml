<Window x:Class="TNovDesktop.MailDigestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводка по почте"
        Width="620" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Foreground="White"
                   TextWrapping="Wrap"
                   Margin="0,6,0,10"/>

        <ListBox x:Name="ItemsList"
                 Grid.Row="2"
                 Background="{StaticResource CardBrush}"
                 BorderBrush="{StaticResource SelectedBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ItemsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4,4,6" Opacity="{Binding Opacity}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding TimeText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding SenderLine}"
                                       Foreground="White"
                                       FontWeight="{Binding Weight}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Subject}"
                                   Foreground="White"
                                   FontWeight="{Binding Weight}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Preview}"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="34"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Двойной щелчок — открыть письмо"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="Закрыть"
                    Style="{StaticResource ActionButtonStyle}"
                    Width="100"
                    Margin="8,0,0,0"
                    Click="CloseButton_Click"/>
            <Button DockPanel.Dock="Right"
                    Content="Открыть Почту"
                    Style="{StaticResource RunButtonStyle}"
                    Width="130"
                    Click="OpenMailButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
