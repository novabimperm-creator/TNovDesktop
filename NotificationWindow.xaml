<Window x:Class="TNovClient.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Hand"
        Width="350"
        Height="Auto"
        SizeToContent="Height"
        Opacity="0">

    <Window.Resources>
        <Style x:Key="NotificationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#8FB3A2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
        </Style>
        <Style x:Key="NotificationTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="10,10,10,5"/>
        </Style>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3"
                             DecelerationRatio="0.8"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.3"
                             AccelerationRatio="0.8"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="10" Margin="10" Background="#1E2E26"
            BorderBrush="#37C871" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="30" CornerRadius="10,10,0,0" Background="#14201A">
                <TextBlock Text="Уведомление"
                           Foreground="#37C871"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="Bold"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <TextBlock x:Name="TitleBlock"
                           Style="{StaticResource NotificationTitleStyle}"
                           Text="Заголовок"/>
                <TextBlock x:Name="MessageBlock"
                           Style="{StaticResource NotificationTextStyle}"
                           Text="Текст уведомления"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
