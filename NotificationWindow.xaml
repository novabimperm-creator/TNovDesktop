<Window x:Class="TNovClient.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="350" 
        Height="Auto"
        SizeToContent="Height"
        Opacity="0">
    <!-- Начальная прозрачность – скрыто -->

    <Window.Resources>
        <!-- Стили для текста -->
        <Style x:Key="NotificationTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="10,0,10,10"/>
        </Style>
        <Style x:Key="NotificationTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Margin" Value="10,10,10,5"/>
        </Style>

        <!-- Анимация появления (Fade In) -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" 
                             Duration="0:0:0.3"
                             DecelerationRatio="0.8"/>
        </Storyboard>

        <!-- Анимация исчезновения (Fade Out) -->
        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" 
                             Duration="0:0:0.3"
                             AccelerationRatio="0.8"/>
        </Storyboard>
    </Window.Resources>

    <!-- Основной контейнер с тенью и скруглением -->
    <Border CornerRadius="10" Margin="10" Background="White">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя полоса с градиентом (как в главном окне) -->
            <Border Grid.Row="0" Height="30" CornerRadius="10,10,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF008E43" Offset="0"/>
                        <GradientStop Color="#FF00AA55" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="Уведомление" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"/>
            </Border>

            <!-- Содержимое уведомления -->
            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                <TextBlock x:Name="TitleBlock" 
                           Style="{StaticResource NotificationTitleStyle}"
                           Text="Заголовок"/>
                <TextBlock x:Name="MessageBlock" 
                           Style="{StaticResource NotificationTextStyle}"
                           Text="Текст уведомления"/>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
           Foreground="#666666">
    <Hyperlink NavigateUri="https://docs.google.com/document/d/1xWRjedTIyR0509Num57whmNdh-rBjuDwmt0NTHmCYh0/edit?usp=sharing" 
               RequestNavigate="Hyperlink_RequestNavigate"
               Foreground="#FF008E43">
        <Run Text="📄 Подробная информация"/>
    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>