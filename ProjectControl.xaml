<UserControl x:Class="TNovDesktop.ProjectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="0,16,0,0" Name="StatusPanel">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔌" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock x:Name="StatusText" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Text="Проверка подключения…"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="HintText" Margin="0,10,0,10" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="12,12,12,0" Name="HeadPanel">
            <StackPanel Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Center">
                <TextBlock x:Name="UserNamePrefixTextBlock" FontSize="16"
                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="UserNameTextBlock" Margin="5,0,0,0"
                           FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="UserRolePrefixTextBlock" Margin="12,0,0,0"
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="UserRoleTextBlock" Margin="5,0,0,0"
                           FontSize="16" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       Text="Журнал выдачи заданий"/>
        </StackPanel>

        <Grid x:Name="TableContainer" Grid.Row="1" Visibility="Collapsed" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Проект:" VerticalAlignment="Center" Margin="0,0,5,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="ProjectComboBox" Width="180"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True" IsTextSearchEnabled="True"/>
                <TextBlock Text="Модель:" VerticalAlignment="Center" Margin="10,0,5,0"
                           Foreground="{StaticResource MutedBrush}"/>
                <ComboBox x:Name="ModelComboBox" Width="180"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True" IsTextSearchEnabled="True"/>
                <Button Content="Очистить фильтры" VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Padding="10,6"
                        MinHeight="32"
                        Click="ClearFiltersButton_Click"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="HoleGrid"
                      Style="{StaticResource DarkDataGridStyle}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single"
                      RowDetailsVisibilityMode="VisibleWhenSelected">
                <DataGrid.Resources>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Setter Property="ToolTip" Value="{Binding MEPComments}" />
                    </Style>

                    <!-- Элементы задания: подсветка изменений последней версии -->
                    <Style x:Key="ElementRowStyle" TargetType="{x:Type DataGridRow}">
                        <Setter Property="ToolTip" Value="{x:Null}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChangeKind}" Value="new">
                                <Setter Property="Background" Value="{StaticResource ElementNewBrush}"/>
                                <Setter Property="ToolTip" Value="Новое в последней версии"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeKind}" Value="changed">
                                <Setter Property="Background" Value="{StaticResource ElementChangedBrush}"/>
                                <Setter Property="ToolTip" Value="Изменено в последней версии"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ChangeKind}" Value="removed">
                                <Setter Property="Background" Value="{StaticResource ElementRemovedBrush}"/>
                                <Setter Property="ToolTip" Value="Удалено в последней версии"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ElementTextStyle" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="удалено">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <Style x:Key="ElementMarkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ElementTextStyle}">
                        <Setter Property="Text" Value="{Binding Mark}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MarkEmpty}" Value="True">
                                <Setter Property="Text" Value="(пусто)"/>
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Щелчок по элементу: его история по версиям -->
                    <DataTemplate x:Key="ElementHistoryTemplate">
                        <ItemsControl ItemsSource="{Binding HistoryEntries}" Margin="28,2,8,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" Foreground="White"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </DataGrid.Resources>

                <!-- Щелчок по группе: элементы задания -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Margin="24,4,8,10">
                            <Grid>
                                <TextBlock Text="История элементов ведётся с версии, выданной после обновления плагина."
                                           Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Elements}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DataGrid ItemsSource="{Binding Elements}"
                                          RowStyle="{StaticResource ElementRowStyle}"
                                          RowDetailsTemplate="{StaticResource ElementHistoryTemplate}"
                                          RowDetailsVisibilityMode="VisibleWhenSelected"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          HorizontalAlignment="Left"
                                          MaxHeight="360"
                                          PreviewMouseWheel="NestedGrid_PreviewMouseWheel">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource DarkDataGridStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Elements}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Марка">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource ElementMarkTextStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" ElementStyle="{StaticResource ElementTextStyle}"/>
                                        <DataGridTextColumn Header="Семейство" Binding="{Binding Family}" ElementStyle="{StaticResource ElementTextStyle}"/>
                                        <DataGridTextColumn Header="Размер, мм" Binding="{Binding SizeText}" ElementStyle="{StaticResource ElementTextStyle}"/>
                                        <DataGridTextColumn Header="Состояние" Binding="{Binding State}" ElementStyle="{StaticResource ElementTextStyle}"/>
                                        <DataGridTextColumn Header="Изменено в версии" Binding="{Binding LastChangedVersion}" ElementStyle="{StaticResource ElementTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Файл">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Файл" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBox x:Name="FilterFileName" Width="160"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             TextChanged="Filter_TextChanged"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ModelName}" VerticalAlignment="Center" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Имя группы">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Имя группы" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBox x:Name="FilterHoleGroup" Width="120"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             TextChanged="Filter_TextChanged"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HoleGroupName}" VerticalAlignment="Center" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Версия">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TaskVersion}" VerticalAlignment="Center" Margin="5,0,5,0" Foreground="White"/>
                                    <Button Content="..."
                                            ToolTip="История версий"
                                            Style="{StaticResource CloseButtonStyleMini}"
                                            Width="24"
                                            Height="22"
                                            FontSize="12"
                                            Click="VersionHistoryButton_Click"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Элементы" Binding="{Binding ElementsSummary}"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding TaskDate}" SortDirection="Descending"/>

                    <DataGridTemplateColumn Header="Выдал">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Выдал" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBox x:Name="FilterInitiator" Width="100"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             TextChanged="Filter_TextChanged"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Initiator}" VerticalAlignment="Center" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Модель КР" Binding="{Binding STModelName}"/>

                    <DataGridTemplateColumn Header="Статус КР">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Статус КР" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBox x:Name="FilterSTStatus" Width="100"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             TextChanged="Filter_TextChanged"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding STStatus}" VerticalAlignment="Center" Foreground="White"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
