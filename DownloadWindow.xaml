<Window x:Class="TNovDesktop.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="360"
        SizeToContent="Height">

    <Border CornerRadius="10" Margin="10" Background="#1E2E26"
            BorderBrush="#37C871" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="20" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="30" CornerRadius="10,10,0,0" Background="#14201A">
                <Grid Margin="10,0">
                    <TextBlock Text="Загрузка"
                               Foreground="#37C871"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="Bold"/>
                    <Button x:Name="CloseButton"
                            Content="✕"
                            Width="22" Height="22"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="CloseButton_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="11"
                            Padding="0"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="12,10,12,12">
                <TextBlock x:Name="FileNameText"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="StatusText"
                           Foreground="#8FB3A2"
                           FontSize="12"
                           Margin="0,4,0,8"
                           Text="Скачивается…"/>

                <ProgressBar x:Name="Progress"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             IsIndeterminate="True"
                             BorderThickness="0"
                             Background="#14201A"
                             Foreground="#37C871"
                             Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenFileButton"
                            Grid.Column="0"
                            Content="Открыть"
                            Style="{StaticResource RunButtonStyle}"
                            Padding="8,6"
                            MinHeight="32"
                            FontSize="12"
                            IsEnabled="False"
                            Click="OpenFile_Click"/>
                    <Button x:Name="OpenFolderButton"
                            Grid.Column="2"
                            Content="Открыть папку"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="8,6"
                            MinHeight="32"
                            FontSize="12"
                            IsEnabled="False"
                            Click="OpenFolder_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
