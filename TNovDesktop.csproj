<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.11.0.0</AssemblyVersion>
    <FileVersion>1.11.0.0</FileVersion>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <PackageIcon>logo.ico</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="resources\logo.ico" />
    <None Remove="resources\logotray.ico" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="IWshRuntimeLibrary">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>f935dc20-1cf0-11d0-adb9-00c04fd58a0b</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>False</Private>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\logo.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="resources\logotray.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- Вкладка «Чек-листы»: ядро отчёта общее с кнопкой «Отчет» в Revit (TNovUtils).
       Файлы подключены ссылкой, без Revit API — правятся только в TNovUtils\Checklist\Report. -->
  <ItemGroup>
    <Compile Include="..\TNovUtils\Checklist\Report\ChecklistCatalog.cs" Link="Checklist\ChecklistCatalog.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ReportLevel.cs" Link="Checklist\ReportLevel.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\RolesReader.cs" Link="Checklist\RolesReader.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\CdeReader.cs" Link="Checklist\CdeReader.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\SyncJournalReader.cs" Link="Checklist\SyncJournalReader.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ModelReportRow.cs" Link="Checklist\ModelReportRow.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ModelReportBuilder.cs" Link="Checklist\ModelReportBuilder.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ReportViewModel.cs" Link="Checklist\ReportViewModel.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ReportExcelExporter.cs" Link="Checklist\ReportExcelExporter.cs" />
    <Compile Include="..\TNovUtils\Checklist\Report\ChecklistDataSource.cs" Link="Checklist\ChecklistDataSource.cs" />
  </ItemGroup>

  <!-- Журнал заданий: модель элемента задания с историей общая с плагином (TNovTasks пишет JSON). -->
  <ItemGroup>
    <Compile Include="..\TNovCommon\Journal\TaskElementRecord.cs" Link="Journal\TaskElementRecord.cs" />
  </ItemGroup>

  <!-- Клиент TNovApi (netstandard2.0, репозиторий ..\TNovApi): JSON Чек-листа при "ChecklistStorage": "api". -->
  <ItemGroup>
    <ProjectReference Include="..\TNovApi\src\TNovApi.Client\TNovApi.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="TProControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="MailControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="TimettaControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Vitro25Control.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Vitro22Control.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="WriteDesktopVersionFile" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishUrl)version.txt" Lines="$(AssemblyVersion)" Overwrite="true" Encoding="UTF-8" />
  </Target>

</Project>
