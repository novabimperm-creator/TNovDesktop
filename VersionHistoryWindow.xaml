<Window x:Class="TNovDesktop.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История версий"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Path=HoleGroupName, StringFormat='Группа: {0}', TargetNullValue='Группа не указана'}"
                   FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   Margin="0,0,0,8"/>

        <TextBox Grid.Row="1"
                 Text="{Binding MEPCommentsHistory}"
                 Style="{StaticResource DarkTextBoxStyle}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"/>

        <Button Grid.Row="2"
                Content="Закрыть"
                Style="{StaticResource ActionButtonStyle}"
                Width="100"
                HorizontalAlignment="Right"
                Margin="0,8,0,0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
